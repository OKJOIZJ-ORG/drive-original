'use strict';
const fs=require('node:fs'),path=require('node:path'),vm=require('node:vm'),test=require('node:test'),assert=require('node:assert/strict');
const fixtureModule={exports:{}};
vm.runInNewContext(fs.readFileSync(path.join(__dirname,'app.test.js'),'utf8').split('\ntest(')[0]+'\nmodule.exports=loadAppContext;', {require,__dirname,module:fixtureModule,AbortController,Blob,DOMException,Headers,Map,Math,Promise,Response,Set,URL,URLSearchParams,clearInterval,clearTimeout,console,fetch,performance,setInterval,setTimeout});
const run=(c,s)=>vm.runInContext(s,c),turn=()=>new Promise(setImmediate);
function fixture(kind='ts',attempt='q1'){const c=fixtureModule.exports();let releaseCleanup;const cleanup=new Promise(r=>releaseCleanup=r);c.cleanup=cleanup;c.navigator.serviceWorker={controller:{},addEventListener(){},removeEventListener(){}};
 run(c,`state.selected={id:'fixture',mimeType:'video/mp4'};state.mediaSession=3;state.playbackSession=5;state.accountId='account';state.authAccountKey='auth';state.driveSessionGeneration=2;state.pendingPlay=false;
 state.mediaAttempt='${attempt}';state.mediaPlaybackMode=PLAYBACK_MODE.REPACKAGED;mediaSourceGeneration=11;initialMediaRouteGeneration=7;
 el.playerSheet={hidden:false};el.videoPlayer={hidden:false,paused:true,currentTime:4,duration:12,volume:0.5,muted:true,playbackRate:1.25,dataset:{mediaSession:'3'},classList:{remove(){}},getAttribute(){return this.src||null;},removeAttribute(){this.src=null;},pause(){this.paused=true;},load(){},src:'blob:fixture'};
 el.imageViewer={hidden:true,dataset:{},classList:{remove(){}},removeAttribute(){}};
 el.customVideoControls={hidden:false};el.stageCenterPlayBtn={hidden:false};el.mediaLoading={hidden:false};el.mediaLoadingText={};el.mediaError={hidden:true};el.mediaErrorTitle={focus(){}};el.mediaErrorMessage={};el.retryMediaButton={};el.openDriveButton={};el.bufferOriginalButton={};el.compatPlayerButton={};el.playerModal={classList:{add(){}}};
 clearMediaSeekWatchdog=clearMediaFrameWatchdog=cancelVideoFrameSampling=cleanupOriginalTempStorage=hideSwipeNeighbor=()=>{};
 globalThis.oldController={postMessage(){throw new Error('redundant worker must not receive a request');}};
 globalThis.owner={fileId:'fixture',session:3,account:'auth',accountGeneration:2,controller:new AbortController(),requiresSwReadiness:true,swController:oldController,swGeneration:11,cleanupOk:true,setupDone:Promise.resolve(),kind:'${kind}',player:{stats:()=>({mapping:null}),dispose:()=>cleanup}};
 q1Playback=owner;q0PinnedSource=Object.freeze({descriptor:Object.freeze({headRevisionId:'A'})});globalThis.originalPin=q0PinnedSource;
 globalThis.reloads=0;globalThis.grants=0;globalThis.newSources=0;window.location.reload=()=>reloads++;requestSessionCredential=()=>{grants++;return Promise.resolve(false)};openMediaSource=()=>newSources++;
 `);
 return {c,releaseCleanup};}
for(const [kind,attempt]of [['ts','q1'],['general','q1'],['general','q1-probing']])test('controller replacement visibly retires '+kind+' '+attempt+' without resetting uncertainty',async()=>{const f=fixture(kind,attempt);assert.equal(run(f.c,'restartPendingMediaAfterServiceWorkerChange()'),true);assert.equal(run(f.c,'owner.controller.signal.aborted'),true);assert.equal(run(f.c,'q1Playback'),null);assert.equal(run(f.c,'el.videoPlayer.hidden'),true);assert.equal(run(f.c,'el.customVideoControls.hidden'),true);assert.equal(run(f.c,'q0PinnedSource===originalPin'),true);assert.equal(run(f.c,'state.resumePosition.snapshot.time'),4);assert.equal(run(f.c,'state.resumePosition.snapshot.paused'),true);assert.equal(run(f.c,'state.mediaSession'),3);assert.equal(run(f.c,'state.mediaAttempt'),'worker-updating');f.releaseCleanup({settled:true});await run(f.c,'q1Retirement');await turn();assert.equal(run(f.c,'q1RetirementResult.settled'),false);assert.equal(run(f.c,'state.mediaAttempt'),'worker-update-required');assert.equal(run(f.c,'el.mediaError.hidden'),false);assert.equal(run(f.c,'el.mediaLoading.hidden'),true);assert.equal(run(f.c,'el.retryMediaButton.textContent'),'¾Û ´Ù½Ã ¿­±â');assert.equal(run(f.c,'newSources'),0);});
for(const change of ["state.selected={id:'other'}","state.mediaSession++","state.playbackSession++","state.accountId='other'","state.authAccountKey='other'","state.driveSessionGeneration++","mediaSourceGeneration++","initialMediaRouteGeneration++","q0PinnedSource={}","el.playerSheet.hidden=true","q1Playback={}"])
test('controller retirement result cannot alter changed owner: '+change,async()=>{const f=fixture();run(f.c,'restartPendingMediaAfterServiceWorkerChange()');run(f.c,change);f.releaseCleanup({settled:true});await run(f.c,'q1Retirement');await turn();assert.equal(run(f.c,'state.mediaAttempt'),'worker-updating');assert.equal(run(f.c,'el.mediaError.hidden'),true);assert.equal(run(f.c,'newSources'),0);});
test('another controller change during retirement still exposes update recovery without transport restart',async()=>{const f=fixture();run(f.c,'restartPendingMediaAfterServiceWorkerChange()');f.c.navigator.serviceWorker.controller={};assert.equal(run(f.c,'restartPendingMediaAfterServiceWorkerChange()'),false);f.releaseCleanup({settled:true});await run(f.c,'q1Retirement');await turn();assert.equal(run(f.c,'state.mediaAttempt'),'worker-update-required');assert.equal(run(f.c,'q1RetirementResult.settled'),false);});
test('controller update action reloads before expired credential handling and preserves false barrier',async()=>{const f=fixture();run(f.c,'restartPendingMediaAfterServiceWorkerChange()');f.releaseCleanup({settled:true});await run(f.c,'q1Retirement');await turn();run(f.c,'state.expiresAt=0;retryMedia()');assert.equal(run(f.c,'reloads'),1);assert.equal(run(f.c,'grants'),0);assert.equal(run(f.c,'newSources'),0);assert.equal(run(f.c,'q1RetirementResult.settled'),false);});
test('controller update cannot act on a closed player selection',async()=>{const f=fixture();run(f.c,'restartPendingMediaAfterServiceWorkerChange()');f.releaseCleanup({settled:true});await run(f.c,'q1Retirement');await turn();run(f.c,'state.selected=null;retryMedia()');assert.equal(run(f.c,'reloads'),0);assert.equal(run(f.c,'newSources'),0);});
test('unchanged controller and stale Q1 account do not capture an unrelated selected lifetime',()=>{for(const change of ['navigator.serviceWorker.controller=oldController',"state.authAccountKey='other'",'state.mediaSession++']){const f=fixture();run(f.c,change);assert.equal(run(f.c,'restartPendingMediaAfterServiceWorkerChange()'),false);assert.equal(run(f.c,'owner.controller.signal.aborted'),false);}});

test('close before controller retirement preserves reload recovery for the next file behind the false barrier',async()=>{const f=fixture();run(f.c,'restartPendingMediaAfterServiceWorkerChange()');run(f.c,"state.selected={id:'next',mimeType:'video/mp4'};state.mediaSession++;state.playbackSession++;mediaSourceGeneration++;state.mediaAttempt='route-selecting';el.playerSheet.hidden=false");f.releaseCleanup({settled:true});await run(f.c,'q1Retirement');await turn();assert.equal(run(f.c,'el.mediaError.hidden'),true);await run(f.c,"startInitialOriginalPlayback(state.selected,'video',state.mediaSession)");assert.equal(run(f.c,'state.mediaAttempt'),'failed');assert.equal(run(f.c,'q1RetirementResult.settled'),false);assert.equal(run(f.c,'el.retryMediaButton.textContent'),'¾Û ´Ù½Ã ¿­±â');run(f.c,'retryMedia()');assert.equal(run(f.c,'reloads'),1);assert.equal(run(f.c,'newSources'),0);assert.equal(run(f.c,'grants'),0);assert.equal(run(f.c,'q1RetirementResult.settled'),false);});
